{
  "name": "nova-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NOVA storefront API. Implements docs/API.md on the schema in docs/DATA_MODEL.md.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "db:reset": "node --env-file-if-exists=.env src/db/reset.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@hono/node-server": "^2.1.11",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.22",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
