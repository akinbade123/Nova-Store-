# Copy to .env. Everything is optional for local development.

# PostgreSQL connection string. Leave unset to use the embedded development database (PGlite),
# which needs nothing installed. Required in production, where it must include sslmode=verify-full
# (encrypted, with the server's certificate checked) unless the database is on the same machine.
# DATABASE_URL=postgres://user:password@localhost:5432/nova
# DATABASE_URL=postgres://nova_api:password@db.example.com:5432/nova?sslmode=verify-full

# The tables' owner, used only for migrations. Defaults to DATABASE_URL. In production, set
# DATABASE_URL to a login that is only a member of nova_app, and this to the owner
# (README, "Database roles").
# DATABASE_MIGRATION_URL=postgres://owner:password@db.example.com:5432/nova?sslmode=verify-full

# Where the embedded development database lives. Must be inside .data/ for `npm run db:reset`.
# PGLITE_DIR=.data/dev

# Port the API listens on. The storefront's Vite dev server forwards /api here.
# PORT=4000

# The storefront's public URL, used for links in emails (password reset). Required in production,
# and must start with https:// there.
# APP_URL=http://localhost:5173

# Where support messages are sent; security emails tell shoppers to write here. Required in production.
# Use an address on a domain you own.
# SUPPORT_EMAIL=support@example.com

# How many proxies you run in front of the API, such as a Vercel rewrite or a load balancer (usually 1).
# Rate limits use the client IP from X-Forwarded-For only when this is set; otherwise anyone could send
# a fake X-Forwarded-For to dodge them. Leave at 0 when clients connect to the API directly.
# TRUST_PROXY_HOPS=0

# Email spending limits (docs/API.md, 9a). Most emails per UTC day across all instances, with a
# warning logged at 80%, and most emails to any one address per hour.
# EMAIL_DAILY_LIMIT=2000
# EMAIL_PER_ADDRESS_PER_HOUR=5

# PostgreSQL connections each API instance opens. Instances × this must stay below your database
# plan's connection limit.
# DB_POOL_MAX=10

# Longest a query may run before PostgreSQL cancels it, in milliseconds. Migrations aren't limited.
# DB_STATEMENT_TIMEOUT_MS=15000

# Graceful shutdown (README, "Deploying"): seconds readiness answers 503 before the server stops taking
# requests (default 5 in production, 0 in development), then the longest to wait for requests in progress.
# SHUTDOWN_DRAIN_SECONDS=5
# SHUTDOWN_TIMEOUT_SECONDS=10
