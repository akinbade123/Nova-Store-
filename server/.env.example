# Copy to .env. Everything is optional for local development.

# PostgreSQL connection string. Leave unset to use the embedded development database (PGlite),
# which needs nothing installed. Required in production.
# DATABASE_URL=postgres://user:password@localhost:5432/nova

# Where the embedded development database lives. Must be inside .data/ for `npm run db:reset`.
# PGLITE_DIR=.data/dev

# Port the API listens on. The storefront's Vite dev server forwards /api here.
# PORT=4000

# The storefront's public URL, used for links in emails (password reset).
# APP_URL=http://localhost:5173

# Where support messages are sent.
# SUPPORT_EMAIL=support@nova.store
