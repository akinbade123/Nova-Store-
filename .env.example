# Base URL of the NOVA backend API
VITE_API_URL=http://localhost:4000/api
# Optional: several backend instances to load-balance across (comma-separated). Replaces
# VITE_API_URL when set. Requests rotate round-robin; a failing instance is skipped for 30s,
# and safe (GET) requests fail over to the next one.
# VITE_API_URLS=https://api1.example.com/api,https://api2.example.com/api
# Set to "false" once the backend is live to stop serving local sample data
VITE_USE_MOCK_DATA=true
# Shows a "Demo store" banner on every page. .env.production turns it on for deploys while the
# live site runs on sample data; delete it there at launch.
# VITE_DEMO_SITE=true
# The domain the shop's email addresses use (support@, privacy@, legal@, careers@).
# Defaults to example.com, a placeholder that reaches no one. Required for a production launch.
# VITE_SITE_DOMAIN=example.com
